{
  "name": "webplayfr",
  "short_name": "webplayfr",
  "description": "YouTube Music with word-by-word lyrics, animated covers and a living background",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#09090b",
